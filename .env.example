# Local data path only. Keep real API keys and lab credentials in an untracked .env file.
CIPHER_LENS_DATA_DIR=./data

# ====================================================================
# Primary AI Provider: Google Gemini (OpenAI-compatible endpoint)
# Simply paste your Gemini API key below.
# Supported Google Models: gemini-2.0-flash-lite, gemini-2.0-flash, gemini-1.5-flash
# (Or preview/custom aliases: gemini-3.1-flash-lite)
# ====================================================================
PROVIDER_1_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PROVIDER_1_API_KEY=
PROVIDER_1_MODEL=gemini-2.0-flash-lite

# ====================================================================
# Fallback AI Provider: Google Gemini Secondary / Fallback Slot
# Simply paste your Gemini API key below (can be same or different key).
# Supported Google Models: gemini-2.0-flash, gemini-1.5-flash
# (Or preview/custom aliases: gemini-3.5-flash-lite)
# ====================================================================
PROVIDER_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PROVIDER_2_API_KEY=
PROVIDER_2_MODEL=gemini-2.0-flash

# Optional local OWASP ZAP daemon; otherwise the adapter checks this default.
ZAP_BASE_URL=http://127.0.0.1:8080

# Optional NIST NVD API 2.0 key for CVE/CVSS enrichment. Leave blank for zero-cost operation.
NVD_API_KEY=
